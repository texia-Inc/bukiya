# 本番環境用設定例
# データベース設定
DATABASE_URL=postgresql://bukiya_user:STRONG_PASSWORD@your-vps-ip:5432/bukiya_game

# Redis設定  
REDIS_URL=redis://your-vps-redis-ip:6379/0

# セキュリティ設定（本番用の強力なキーに変更）
SECRET_KEY=your_very_strong_secret_key_here_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=365

# 環境設定
ENVIRONMENT=production

# CORS設定（本番ドメインに変更）
ALLOWED_HOSTS=["yourdomain.com", "www.yourdomain.com", "api.yourdomain.com"]

# ログ設定
LOG_LEVEL=WARNING